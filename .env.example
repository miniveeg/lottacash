# Frontend
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_NETWORK=mainnet-beta
# Production API origin, e.g. https://api.lottacash.us/api
# VITE_API_URL=

# --- Monetization (Jupiter platform fee) ---
# 50 = 0.5% of each copy swap. Set 0 to disable.
VITE_PLATFORM_FEE_BPS=50
# Your treasury wallet (public key). Must have ATAs for WSOL (and ideally USDC).
# Create WSOL ATA: receive a tiny WSOL amount or use a wallet UI / CLI.
VITE_FEE_WALLET=

# Optional Jupiter portal key for higher rate limits
# VITE_JUPITER_API_KEY=
